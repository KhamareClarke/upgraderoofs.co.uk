# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# Google service account credentials (private key — never commit)
google-service-account.json

# audit / export artifacts (generated output, not source)
master-audit-results.json
scripts_out_hist.txt
gsc-export/

# indexing resume runtime state (regenerated per-run, never commit)
scripts/.indexing-state.json

# local lead audit log (generated at runtime, contains PII — never commit)
/data/leads-audit.jsonl

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Supabase CLI scratch (created by `supabase` invocations, e.g. --version)
supabase/.temp/
