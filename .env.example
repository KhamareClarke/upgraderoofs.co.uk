# ── Tracking & Analytics ──────────────────────────────
# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Ads
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX

# Google Ads conversion label (format: AW-XXXXX/YYYYY)
# Used as the 'send_to' value for conversion events
NEXT_PUBLIC_GA_CONVERSION_SEND_TO=AW-XXXXXXXXXX/YYYYYYYYY

# Google Ads conversion ID for phone/WhatsApp tap clicks (low-value engagement).
# MUST be a dedicated conversion action ID (not the lead-form ID) — format AW-XXX/YYY.
# If unset, phone/WhatsApp taps send NO conversion to Google Ads (they no longer
# fall back to the £50 lead-form action). Create the action in Google Ads →
# Tools → Conversions, then set its ID here and in Vercel.
NEXT_PUBLIC_GADS_CLICK_CONV_ID=AW-XXXXXXXXXX/YYYYYYYYY

# Meta (Facebook) Pixel
NEXT_PUBLIC_FB_PIXEL_ID=XXXXXXXXXXXXXXX

# ── Supabase (Database) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Email (contact forms via Gmail SMTP + Nodemailer) ──
# Use a Gmail App Password (Google Account → Security → 2-Step Verification → App passwords).
# Do not use your normal Gmail password.
SMTP_USER=your.address@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=your.address@gmail.com
EMAIL_TO=upgraderoofs@yahoo.com

# Optional: if you switch the API routes to Resend instead of Nodemailer
# RESEND_API_KEY=re_XXXXXXXXXX

# ── Optional: Google Maps ────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── GoHighLevel (lead + call pipeline) ────────────────
# Used by API routes to upsert form leads and inbound call events into the GHL
# sub-account. Private Integration token, scoped to a single location.
GHL_LOCATION_ID=your-location-id
GHL_API_KEY=pit-xxxxxxxxxxxxxxxxxxxx

# ── Owner-notification SMS (lib/sms-notify.ts) ────────
# Texts the business owner when a website lead arrives. Dispatched through GHL's
# conversations API, so it may use a DIFFERENT sub-account than lead capture —
# the sending number has to be provisioned in whichever location is named here.
#
# These are ALL optional as a group. If any one is missing the notifier degrades
# to a single logged warning and no-ops; it never throws, so an SMS problem can
# never cost you a lead. That also means a silent no-op is the failure mode —
# after deploying, confirm the vars are actually set in Vercel.
#
# SMS_GHL_API_KEY and SMS_LOCATION_ID fall back to GHL_API_KEY/GHL_LOCATION_ID
# when unset, so a single-account setup only needs the two below.
SMS_GHL_API_KEY=pit-xxxxxxxxxxxxxxxxxxxx
SMS_LOCATION_ID=your-sms-location-id
# Must be a number PROVISIONED in SMS_LOCATION_ID. An arbitrary number you own
# will be rejected or silently swapped for the location's primary number.
SMS_SENDER_PHONE=+447700900000
# The owner's mobile. Upserted as a contact in SMS_LOCATION_ID on first send.
MARCUS_PHONE=+447700900000
# Display name for that contact. Defaults to "Marcus".
# SMS_RECIPIENT_NAME=Marcus

# ── Call Tracking Webhook ─────────────────────────────
# Shared secret guarding POST /api/webhooks/call-tracking against spoofed call
# events. Set the same value in Vercel env and configure your call-tracking
# provider (CallRail / Twilio / Google Forwarding) to send it as the
# `x-call-secret` header (or `?secret=` query param / `secret` body field).
# When unset, the endpoint accepts all callers (fine for local bring-up only).
CALL_TRACKING_WEBHOOK_SECRET=replace-with-a-long-random-secret
