# ── Tracking & Analytics ──────────────────────────────
# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX

# Google Analytics 4
# NOTE: this is the name the code actually reads (components/Analytics.tsx and
# lib/tracking.ts). It was previously documented here as NEXT_PUBLIC_GA_ID,
# which nothing reads — setting that name had no effect.
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Send custom events (phone_click, quote_request, …) straight to GA4 via gtag,
# in addition to the GTM dataLayer push. Defaults to enabled when unset.
#
# Why: the GTM triggers that were supposed to forward these dataLayer events to
# GA4 were never built, so GA4 received none of them. Direct dispatch fixes that
# without touching the GTM container. If you later DO build those triggers, set
# this to false or every event will be counted twice.
# NEXT_PUBLIC_GA4_DIRECT_EVENTS=true

# ── GA4 Data API (server-side reads for the private dashboard) ─────────
# The numeric property id, NOT the G- measurement id above. Find it in GA4 →
# Admin → Property settings (it is the digits in the URL).
# GA4_PROPERTY_ID=000000000

# The service-account key that READS the property, as the JSON file's contents on
# one line. The same service account used for Search Console; it must be added as
# a Viewer on the GA4 property (Access Management) or every report returns 403.
#
# Why a service account and not the Google Ads refresh token: a refresh token's
# scopes are fixed when consent is granted, and analytics.readonly was never one
# of them — re-exchanging it fails with invalid_scope.
#
# Why inline and not a file path: deployments are built from git, the key file is
# gitignored, so it is never uploaded. GOOGLE_APPLICATION_CREDENTIALS (a path) is
# read as a fallback and works locally, on a machine that has the file.
#
# Unset = the dashboard's click panel reports itself unavailable. It does not fall
# back to a zero, which would read as "nobody clicks anything".
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}

# Google Ads account id (the container config, not a conversion action)
# NOTE: previously documented as NEXT_PUBLIC_GOOGLE_ADS_ID, which nothing reads.
NEXT_PUBLIC_GADS_ID=AW-XXXXXXXXXX

# Google Ads lead-form conversion target.
# MUST be the COMPLETE `AW-XXXXXXXXXX/YYYYYYYYY` value — account id, a slash, and
# the conversion action's label. The account id alone is not a valid 'send_to':
# Google Ads rejects it, so lead-form conversions silently record nothing while
# looking configured. Find the label in Google Ads → Tools → Conversions.
# NOTE: previously documented as NEXT_PUBLIC_GA_CONVERSION_SEND_TO.
NEXT_PUBLIC_GADS_CONV_ID=AW-XXXXXXXXXX/YYYYYYYYY

# Google Ads conversion ID for phone/WhatsApp tap clicks (low-value engagement).
# MUST be a dedicated conversion action ID (not the lead-form ID) — format AW-XXX/YYY.
# If unset, phone/WhatsApp taps send NO conversion to Google Ads (they no longer
# fall back to the £50 lead-form action). Create the action in Google Ads →
# Tools → Conversions, then set its ID here and in Vercel.
NEXT_PUBLIC_GADS_CLICK_CONV_ID=AW-XXXXXXXXXX/YYYYYYYYY

# Google Ads conversion action for COMPLETED PHONE CALLS (website call
# conversions). Different from the line above: CLICK_CONV_ID reports that someone
# pressed dial; this one reports that someone actually phoned, and how long the
# call lasted. Google swaps in a forwarding number for ad-click visitors, records
# ring/answer/duration, then connects the caller to the real line.
#
# MUST be the COMPLETE `AW-XXXXXXXXXX/YYYYYYYYY` value, and the account half MUST
# match NEXT_PUBLIC_GADS_ID above. This is the ONE place where the label must NOT
# be stripped: for a call conversion the label is what identifies the conversion
# action, and a bare account id here configures cleanly and records nothing.
# Analytics.tsx refuses a malformed value and logs a warning.
#
# LEFT UNSET BY DEFAULT, ON PURPOSE. Unset = the whole feature is inert and the
# site behaves exactly as it did before, so this code can ship before the Ads
# account is configured. Get the label by running:
#     node scripts/setup-website-call-conversions.js            # dry run
#     node scripts/setup-website-call-conversions.js --apply
# Then set it here AND in Vercel, and REDEPLOY — an env var alone changes
# nothing until a deployment picks it up.
NEXT_PUBLIC_GADS_CALL_CONV_ID=

# Meta (Facebook) Pixel
NEXT_PUBLIC_FB_PIXEL_ID=XXXXXXXXXXXXXXX

# ── Supabase (Database) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional but recommended: used by lib/lead-health.ts to write pipeline outcomes
# via a privileged key instead of the anon key. Without it the health module
# falls back to the anon key, which works (the migration grants anon INSERT) but
# means anyone holding the public anon key could pollute the health table and
# mask a real outage. Not required to run.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Email (lead notification via SMTP + Nodemailer) ───
# Every notification email for all three forms goes through lib/mail.ts.
#
# Use a Gmail App Password — NOT the account password.
# Google Account → Security → 2-Step Verification → App passwords.
#
# ⚠ THIS IS THE FRAGILE PART OF THE PIPELINE. Google revokes every App Password
#   the moment the account password changes or 2-Step Verification is toggled.
#   When that happens nothing throws at the edge: GHL keeps capturing leads, the
#   owner SMS still sends, the form still reports success — and only the email
#   dies. Production ran in exactly that state (535-5.7.8 BadCredentials, the
#   "We could not deliver your message by email" message) until someone read the
#   server logs. Get-email delivery is now monitored as the `email` channel by
#   lib/lead-health.ts / GET /api/health/lead-pipeline.
#
#   Verify a credential BEFORE deploying, not after:
#     node scripts/verify-email-transport.js
#
#   To check what production actually holds — SMTP_* are not marked Sensitive in
#   Vercel, so unlike the GHL tokens they DO pull back readable:
#     vercel env pull .env.prod.tmp --environment=production
#     node scripts/verify-email-transport.js .env.prod.tmp && rm .env.prod.tmp
#
#   A Vercel env change does NOT reach a running deployment — always redeploy.
SMTP_USER=your.address@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=your.address@gmail.com
# Unset does NOT fail — it silently falls back to upgraderoofs@yahoo.com, so a
# typo here means notifications go to the wrong mailbox while looking healthy.
# The preflight script flags it.
EMAIL_TO=upgraderoofs@yahoo.com

# Escape hatch: repoint the same code at any SMTP provider without touching the
# three lead routes. Defaults to smtp.gmail.com:465 (implicit TLS); port 587
# negotiates STARTTLS automatically, so set SMTP_SECURE only to override that.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true

# ── Optional: Google Maps ────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── GoHighLevel (lead + call pipeline) ────────────────
# TWO sub-accounts are in play. Which one a call reaches is decided by the
# LOCATION ID in the request, not by which code path made it:
#
#   GHL_LOCATION_ID  Lk9anvdNEEpmFiRndNJk  "Upgrade Roofs"      ← Marcus's CRM
#   SMS_LOCATION_ID  DjRJFFDoB7f6WUJjZvfh  "Khamareclarke com"  ← SMS dispatch
#
# Form leads (send-quote / send-contact / send-special-offer) and inbound call
# events are upserted into GHL_LOCATION_ID. The owner-notification SMS is sent
# from SMS_LOCATION_ID. Those are the only two places either id is read.
#
# TOKENS ARE LOCATION-SCOPED AND NOT INTERCHANGEABLE. A Private Integration
# token only works against the location it was issued for. Each id above needs
# a token from ITS OWN sub-account:
#
#   GHL_API_KEY      → mint inside "Upgrade Roofs"      (Lk9anvdNEEpmFiRndNJk)
#   SMS_GHL_API_KEY  → mint inside "Khamareclarke com"  (DjRJFFDoB7f6WUJjZvfh)
#
#   ⚠ The classic failure here is pasting the SMS token into BOTH slots. It
#     authenticates fine, the SMS preflight passes, and every CRM call then
#     returns 403 Forbidden — because the token has no grant on the location in
#     the URL. Verified on this project: the Khamareclarke-com token returns
#     HTTP 200 for DjRJFFDoB7f6WUJjZvfh and HTTP 403 for Lk9anvdNEEpmFiRndNJk.
#
#   Diagnose a 403 by checking WHICH location the token can see, not by
#   re-reading the code. GET /locations/{id} with the token returns:
#     200 = token has access · 403 = token is scoped elsewhere · 404 = bad id.
#
# SMS_GHL_API_KEY and SMS_LOCATION_ID fall back to GHL_API_KEY/GHL_LOCATION_ID
# when unset. That fallback is only safe when ONE location is in play — with two
# sub-accounts, leaving SMS_* unset points SMS at the CRM token and the send
# fails. Set both explicitly.
#
#   Verify the SMS side with: node scripts/probe-sms-account.js
#   (It only exercises SMS_LOCATION_ID — a pass does NOT prove the primary
#    token works, which is how the shared-token bug stayed hidden.)
GHL_LOCATION_ID=Lk9anvdNEEpmFiRndNJk
GHL_API_KEY=pit-xxxxxxxxxxxxxxxxxxxx

# GHL custom field IDs for contact upsert. These are ACCOUNT-SPECIFIC: the ids
# below belong to "Upgrade Roofs" and are meaningless in any other location, so
# they must be re-created and re-read if you ever point GHL_LOCATION_ID
# elsewhere. lib/ghl.ts skips any field whose id is unset rather than erroring,
# which means a wrong or missing id here loses the data SILENTLY — the contact
# still upserts, so nothing looks broken. Create/read ids in
# GHL → Settings → Custom Fields.
GHL_CF_GCLID=your-custom-field-id
GHL_CF_POSTCODE=your-custom-field-id
GHL_CF_SERVICE_TYPE=your-custom-field-id
GHL_CF_ROOF_TYPE=your-custom-field-id
GHL_CF_SERVICE_NEEDED=your-custom-field-id

# ── Owner-notification SMS (lib/sms-notify.ts) ────────
# Texts the business owner when a website lead arrives. Dispatched through GHL's
# conversations API from a SEPARATE sub-account — "Khamareclarke com"
# (DjRJFFDoB7f6WUJjZvfh) — while leads land in "Upgrade Roofs"
# (Lk9anvdNEEpmFiRndNJk). SMS_GHL_API_KEY must be a token issued INSIDE
# Khamareclarke com — the CRM token will not work here, and vice versa; see the
# GHL block above. The sending number must be PROVISIONED in the location named
# here.
#
# These are ALL optional as a group. If any one is missing the notifier degrades
# to a single logged warning and no-ops; it never throws, so an SMS problem can
# never cost you a lead. That also means a silent no-op is the failure mode —
# after deploying, confirm the vars are actually set in Vercel.
#
# SMS_GHL_API_KEY and SMS_LOCATION_ID fall back to GHL_API_KEY/GHL_LOCATION_ID
# when unset, so a single-account setup only needs the two below.
SMS_GHL_API_KEY=pit-xxxxxxxxxxxxxxxxxxxx
SMS_LOCATION_ID=DjRJFFDoB7f6WUJjZvfh
# Must be a number PROVISIONED in SMS_LOCATION_ID. An arbitrary number you own
# will be rejected or silently swapped for the location's primary number.
SMS_SENDER_PHONE=+447700900000
# The owner's mobile. Upserted as a contact in SMS_LOCATION_ID on first send.
MARCUS_PHONE=+447700900000
# Display name for that contact. Defaults to "Marcus".
# SMS_RECIPIENT_NAME=Marcus

# ── Lead pipeline health (lib/lead-health.ts) ─────────
# Monitors whether leads are still being captured and whether GHL / SMTP / the
# owner SMS are still succeeding. Read by GET /api/health/lead-pipeline, which
# returns 503 when something has gone quiet for too long.
#
# Why this exists: a spam-filter bug silently discarded every lead carrying an
# email address for 19 days. Nothing threw, every form said "success", and the
# only trace was a console.log nobody reads.
#
# REQUIRES the lead_pipeline_events migration (supabase/migrations). Without a
# reachable table the endpoint reports store:"unavailable" and returns 503 —
# it will not report a false "healthy".
#
# How long a channel may go silent before it counts as broken. Default 3.
# LEAD_HEALTH_MAX_SILENCE_DAYS=3

# Optional. When set, /api/health/lead-pipeline requires ?secret= or an
# x-health-secret header. Unset means the endpoint is open (it exposes only
# channel names, timestamps and counts — no customer data).
# LEAD_HEALTH_SECRET=replace-with-a-long-random-secret

# ── Call Tracking Webhook ─────────────────────────────
# Shared secret guarding POST /api/webhooks/call-tracking against spoofed call
# events. Set the same value in Vercel env and configure your call-tracking
# provider (CallRail / Twilio / Google Forwarding) to send it as the
# `x-call-secret` header (or `?secret=` query param / `secret` body field).
# When unset, the endpoint accepts all callers (fine for local bring-up only).
CALL_TRACKING_WEBHOOK_SECRET=replace-with-a-long-random-secret
# ── Fleet diagnostics ─────────────────────────────────
# Shared secret guarding GET /api/fleet/diagnose. Set the same value in Vercel.
# Send it as the `x-fleet-secret` header or the `?secret=` query param.
#
# This route is an operator tool with no machine caller, so it FAILS CLOSED:
# when this var is unset the endpoint returns 401 to everyone rather than
# accepting anonymous callers. (Contrast CALL_TRACKING_WEBHOOK_SECRET above,
# which stays open when unset because a call provider will depend on it.)
#
# Why this exists: the route used to have no guard at all while returning
# partial FLEET_INGEST_SECRET / EMPIRE_INGEST_SECRET values and performing an
# authenticated outbound POST on the caller behalf.
# FLEET_DIAGNOSE_SECRET=replace-with-a-long-random-secret
# ── GHL proxy routes (app/api/ghl/*) ───────────────────
# Shared secret guarding POST /api/ghl/chat, POST /api/ghl/book-appointment
# and GET /api/ghl/calendar-slots. Set the same value in Vercel (and in
# whatever calls them). Header x-ghl-secret, or ?secret=.
#
# FAILS CLOSED: when unset, all three return 401 to every caller. They are
# proxies for our own frontend, not receivers for a third-party provider, so
# an unset var must not mean open.
#
# One secret covers all three on purpose: same GHL location, same token, same
# caller. Rotating it means updating the caller too. If the caller is browser
# JavaScript, remember the value is visible in page source — that stops
# scanners, not a determined party; pair it with an origin check and rate
# limiting if the routes are called from the client.
# GHL_PROXY_SECRET=replace-with-a-long-random-secret

# ── Fleet ingest secret (rotation) ─────────────────────
# Bearer secret used by lib/fleet-ingest.ts to POST telemetry to the fleet hub
# (khamareclarke.com), and by GET /api/fleet/diagnose to test that wiring.
#
# MUST be identical in three places: this env, the Vercel env, and the hub.
# Rotated 2026-09-15 because the previous value was partially disclosed — the
# old /api/fleet/diagnose response exposed its first 3 + last 3 characters and
# exact length to anonymous callers. Rotating requires updating the hub in the
# same window or fleet telemetry starts failing with 401.
# FLEET_INGEST_SECRET=replace-with-a-long-random-secret

# ── Private dashboard slug ─────────────────────────────
# The URL slug for the no-login lead dashboard, which lives at
# /dashboard/<slug>. THE SLUG IS THE ENTIRE ACCESS CONTROL — anyone holding the
# URL sees the numbers, so it must stay long, random and unshared outside the
# business. It is deliberately an env var rather than a literal in the source,
# so it never enters git (this file is tracked; .env.local is not).
#
# Unset means the dashboard 404s on every path. That is the fail-CLOSED
# behaviour, matching /api/fleet/diagnose — a guard whose absence silently
# opens the door is worse than one that takes the tool offline.
#
# Rotating: generate a new value (node -e "console.log('marcus-'+require('crypto').randomBytes(12).toString('hex'))"),
# set it in Vercel, redeploy, and re-add the home-screen shortcut — the old URL
# dies the moment the new value deploys.
# DASHBOARD_MARCUS_SLUG=marcus-replace-with-24-hex-chars
